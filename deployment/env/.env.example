# Create the canonical env file with:
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap_local_runtime.ps1
# That command creates `C:\ProgramData\ImmoApp\config\.env.local` from this template if missing.
# Keep application secrets in OpenBao; values below are bootstrap/runtime config only unless noted.
# Operator-edit values are marked with `<REPLACE_ME...>` placeholders and must be updated before stack bring-up.
# `.env` is deprecated in this repo policy.
# DJANGO_SECRET_KEY is loaded from OpenBao in normal runtime.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
IMMOAPP_ENV=dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
IMMOAPP_WEB_BIND_HOST=127.0.0.1
WEB_PORT=8000
IMMOAPP_BACKEND_HOST_PORT=8000
IMMOAPP_CADDY_BIND_HOST=127.0.0.1
IMMOAPP_HUB_FRONT_DOOR_PORT=8000
IMMOAPP_HUB_FRONT_DOOR_URL=http://127.0.0.1:8000
COMPOSE_PROFILES=
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=Africa/Algiers
DJANGO_ADMIN_PATH=admin/
DJANGO_ADMIN_ALLOWED_IPS=127.0.0.1,::1
DJANGO_TRUST_PROXY=0
DJANGO_NUM_PROXIES=1
# Optional: API Deprecation/Sunset headers (JSON list of policies)
# Example:
# API_DEPRECATION_POLICIES=[{"path_prefix":"/api/v1/","deprecation":true,"sunset":"Sat, 01 Jan 2028 00:00:00 GMT","successor":"/api/v2/"}]
IMMOAPP_APPDATA_ROOT=C:/ProgramData/ImmoApp
IMMOAPP_VERIFY_SCHEMA=1
IMMOAPP_DEFAULT_COUNTRY_CODE=213
ALE_KEY_VERSION=v1
# ALE_* secrets are loaded from OpenBao in normal runtime.
ALE_MASTER_KEY=
# Optional master used to derive per-agency/per-version search secrets.
# If set, it takes precedence over ALE_SEARCH_SECRET.
ALE_SEARCH_SECRET_MASTER=
ALE_SEARCH_SECRET=
ALE_KDF_SALT=
AUDIT_LOG_MAX_LIMIT=1000
CACHE_BATCH_THRESHOLD=1000
CACHE_CHUNK_SIZE=5000

POSTGRES_DB=immoapp
POSTGRES_USER=immoapp_app
POSTGRES_PASSWORD=<REPLACE_ME_STRONG_PASSWORD>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
PG_POOL_MIN=5
PG_POOL_MAX=20
PG_POOL_TIMEOUT=10
PG_POOL_WARMUP_TIMEOUT=10
PG_STATEMENT_TIMEOUT_MS=30000
PG_LOCK_TIMEOUT_MS=5000
PG_IDLE_TX_TIMEOUT_MS=60000
PG_SLOW_QUERY_MS=500
PG_LOG_QUERIES=0
PG_MAX_SQL_LOG_LEN=500
POSTGRES_ADMIN_USER=immoapp
POSTGRES_ADMIN_PASSWORD=<REPLACE_ME_STRONG_PASSWORD>

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=immoapp-server
OTEL_WORKER_SERVICE_NAME=immoapp-worker
# Docker app runtime OTEL endpoint override (leave empty to disable OTEL in compose.app.yml).
# `scripts/stack.ps1 -Action up-full` and `make up-full` set these automatically.
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=
OTEL_EXPORTER_OTLP_PROTOCOL_DOCKER=http/protobuf
OTEL_SERVICE_NAME_DOCKER=immoapp-server
OTEL_WORKER_SERVICE_NAME_DOCKER=immoapp-worker
SIGNOZ_URL=http://127.0.0.1:3301
SIGNOZ_API_KEY=
SIGNOZ_EMAIL=
SIGNOZ_PASSWORD=
SIGNOZ_ORG_ID=
SIGNOZ_BOOTSTRAP_EMAIL=
SIGNOZ_BOOTSTRAP_PASSWORD=
SIGNOZ_PAT_NAME=immoapp-automation
SIGNOZ_PAT_ROLE=ADMIN
SIGNOZ_WRITE_API_KEY_FILE=
SIGNOZ_ALERT_EMAIL_TO=
SIGNOZ_EMAILING_ENABLED=0
SIGNOZ_EMAILING_FROM=
SIGNOZ_EMAILING_ADDRESS=
SIGNOZ_EMAILING_AUTH_USERNAME=
SIGNOZ_EMAILING_AUTH_PASSWORD=
SIGNOZ_SMTP_HOST=
SIGNOZ_SMTP_PORT=587

VALKEY_URL=redis://localhost:6379/1
CHANNEL_LAYER_URL=redis://localhost:6379/3

# Object storage (MinIO/S3)
MINIO_ROOT_USER=immoapp
MINIO_ROOT_PASSWORD=<REPLACE_ME_STRONG_PASSWORD>
# MinIO built-in KMS (format: key-name:32+chars). Use a secrets manager in prod.
MINIO_KMS_SECRET_KEY=immoapp-kms-key:<BASE64_32_BYTES>
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=immoapp
STORAGE_SECRET_KEY=<REPLACE_ME_STRONG_PASSWORD>
STORAGE_BUCKET=immoapp
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=0
STORAGE_MAX_FILE_MB=25
STORAGE_MAX_INLINE_MEDIA_KB=256
STORAGE_AGENCY_QUOTA_MB=2048
STORAGE_USER_DAILY_MAX_FILES=200
STORAGE_VIRUS_SCAN=0
STORAGE_VIRUS_SCAN_REQUIRED=0
STORAGE_PRESIGN_SECONDS=900
STORAGE_SSE=
# If STORAGE_SSE=aws:kms, set the key id (name from MINIO_KMS_SECRET_KEY or cloud KMS).
STORAGE_SSE_KMS_KEY_ID=immoapp-kms-key

# Secrets backend (OpenBao required by default; use IMMOAPP_ALLOW_ENV_SECRETS=1 for break-glass only)
IMMOAPP_SECRETS_BACKEND=openbao
# Keep secrets segmented per environment.
IMMOAPP_SECRETS_PATH=secret/data/immoapp/dev
# Include runtime secret namespaces so env.local can stay bootstrap-only.
IMMOAPP_SECRETS_ALLOWLIST=ALE_,DJANGO_,IMMOAPP_,POSTGRES_,RABBITMQ_,CELERY_BROKER_URL,MINIO_,STORAGE_,SIGNOZ_,JWT_
IMMOAPP_SECRETS_REQUIRED=1
IMMOAPP_SECRETS_OVERWRITE=1
IMMOAPP_ALLOW_ENV_SECRETS=0
# Optional strict startup gate: comma list of keys/prefixes. Example:
# IMMOAPP_SECRETS_REQUIRED_KEYS=ALE_KEY_VERSION,ALE_MASTER_KEY,ALE_SEARCH_SECRET
IMMOAPP_SECRETS_REQUIRED_KEYS=
# Host-side OpenBao address for bootstrap scripts and host-local debug mode.
BAO_ADDR=http://127.0.0.1:8200
# Docker override used by compose.yml app services.
BAO_ADDR_DOCKER=http://openbao:8200
# Runtime policy: keep BAO_TOKEN empty; use BAO_TOKEN_FILE, BAO_APPROLE_FILE, or AppRole ids.
BAO_TOKEN=
BAO_TOKEN_FILE=C:/ProgramData/ImmoApp/secrets/openbao.token
# JSON file with `app_role_id` + `app_secret_id` (recommended for local).
BAO_APPROLE_FILE=C:/ProgramData/ImmoApp/secrets/openbao-approle.json
BAO_ROLE_ID=
BAO_SECRET_ID=
BAO_NAMESPACE=
# Environment-scoped AppRole name (used by seed/bootstrap).
OPENBAO_APP_ROLE_NAME=immoapp-server-dev
# BAO_VERIFY_SSL must be 0 for http:// endpoints and 1 for https:// endpoints.
BAO_VERIFY_SSL=0
# Optional docker override used by compose.yml app services.
BAO_VERIFY_SSL_DOCKER=0
# Optional docker-only files used by runtime bootstrap/init containers.
BAO_BOOTSTRAP_TOKEN_FILE_DOCKER=/run/immoapp-secrets/openbao.token
BAO_UNSEAL_KEY_FILE_DOCKER=/run/immoapp-secrets/openbao.unseal
BAO_APPROLE_FILE_DOCKER=/run/immoapp-secrets/openbao-approle.json
OPENBAO_APP_ROLE_NAME_DOCKER=immoapp-server-dev
# AppRole SecretID TTL (must be non-zero for production).
OPENBAO_APPROLE_SECRET_ID_TTL=168h
CLAMAV_BIN=clamscan
STORAGE_CLAMD_SOCKET=
STORAGE_CLAMD_HOST=
STORAGE_CLAMD_PORT=3310
STORAGE_CLAMD_TIMEOUT=10

# Optional host-local override. Docker-local compose derives this from RABBITMQ_* automatically.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
MATCH_REBUILD_CHUNK_DELAY_SEC=0
MATCH_CACHE_ONLY=1
RABBITMQ_USER=immoapp
RABBITMQ_PASSWORD=<REPLACE_ME_STRONG_PASSWORD>

CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=0

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=1
JWT_BLACKLIST_AFTER_ROTATION=1
TOKEN_REFRESH_THROTTLE=10/minute
TOKEN_OIDC_THROTTLE=20/minute

# OIDC / SSO (disabled by default)
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_AUDIENCES=
OIDC_USERNAME_CLAIMS=preferred_username,email,sub
OIDC_EMAIL_CLAIM=email
OIDC_TIMEOUT_SECONDS=8
OIDC_CACHE_TTL_SECONDS=300
OIDC_INSECURE_SKIP_VERIFY=0

CSP_HEADER="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
