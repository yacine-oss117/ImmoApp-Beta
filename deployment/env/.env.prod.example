# Production environment template (do not commit real secrets).
# Use with:
#   powershell -ExecutionPolicy Bypass -File scripts/stack.ps1 -Action up-prod -EnvFile .env.prod
#   powershell -ExecutionPolicy Bypass -File scripts/stack.ps1 -Action preflight-prod -EnvFile .env.prod

IMMOAPP_ENV=production
DJANGO_DEBUG=0

# Public URL used in emails and approval links.
IMMOAPP_PUBLIC_BASE_URL=https://app.example.com
DJANGO_ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1,web
IMMOAPP_TLS_DOMAIN=app.example.com

# Transport security
SECURE_SSL_REDIRECT_DOCKER=1
SESSION_COOKIE_SECURE_DOCKER=1
CSRF_COOKIE_SECURE_DOCKER=1

# OpenBao must be HTTPS with certificate verification enabled.
BAO_ADDR_DOCKER=https://openbao:8200
BAO_VERIFY_SSL_DOCKER=1
BAO_TIMEOUT_DOCKER=8
BAO_CACERT_DOCKER=/run/immoapp-secrets/openbao-ca.crt
IMMOAPP_OPENBAO_TLS_DIR=C:/ProgramData/ImmoApp/secrets/openbao/tls

# Database
POSTGRES_DB=immoapp
POSTGRES_ADMIN_USER=immoapp_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SECRET
POSTGRES_USER=immoapp_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET

# Queue
RABBITMQ_USER=immoapp
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_SECRET

# Object storage
MINIO_ROOT_USER=immoapp
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_SECRET
MINIO_KMS_SECRET_KEY=immoapp-kms-key:REPLACE_WITH_BASE64_32BYTE_KEY
STORAGE_BUCKET=immoapp
