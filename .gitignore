release_artifacts/

# Jupyter
.ipynb_checkpoints/

# Downloaded verification tooling
tools/tla/tla2tools.jar

# Optional local font binaries (the app falls back to system fonts)
app/assets/fonts/*.ttf
app/assets/fonts/*.otf
