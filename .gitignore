.vscode/
.idea/
*.swp
*.swo
*~

# Cache
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
/Microsoft/Windows/PowerShell/ModuleAnalysisCache

# Environment
/.venv/
/venv/
/ENV/
/env/
.env
.env.local
.env.prod
.env.*
!.env.example
!.env.local.example
!.env.prod.example
