coverage.xml
*.cover

# Testing
.tox/
.nox/

# Generated benchmark/performance evidence
scripts/benchmark_outputs/
scripts/perf_outputs/
scripts/profiling/

# Developer-local release artifacts. Stable release artifacts must be published
